/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' https://lastfm.freetls.fastly.net https://coverartarchive.org https://archive.org https://*.archive.org https://cdn-images.dzcdn.net https://e-cdns-images.dzcdn.net data:; media-src 'self' https://*.dzcdn.net https://audio-ssl.itunes.apple.com https://*.mzstatic.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  # revalidate every visit (cheap via etag): a stale copy kept a phone on the empty state
  Cache-Control: no-cache
